#version 440
// GenyCaster Glass G — hardware-rendered, volumetric SDF. QSB generated by
// Qt Shader Baker for Vulkan, Metal, D3D and WebGL/OpenGL ES. No WebView.
// The extruded ring and directional key are rotated in real 3-D on the GPU.
layout(location=0) in vec2 qt_TexCoord0;
layout(location=0) out vec4 fragColor;

layout(std140,binding=0) uniform Params {
    mat4 qt_Matrix;
    float qt_Opacity;
    vec2 paneSize;
    vec2 pointer;
    float darkMode;
    float pulseValue;
    float orbitYaw;      // degrees, auto-rotation
    float dragYaw;       // degrees, manual interaction
    float dragPitch;     // degrees, manual interaction
} params;

float sdBox(vec2 p,vec2 b) {
    vec2 q=abs(p)-b;
    return length(max(q,0.0))+min(max(q.x,q.y),0.0);
}
float sdTriangle(vec2 p,vec2 a,vec2 b,vec2 c) {
    vec2 e0=b-a,e1=c-b,e2=a-c;
    vec2 v0=p-a,v1=p-b,v2=p-c;
    vec2 x0=v0-e0*clamp(dot(v0,e0)/dot(e0,e0),0.,1.);
    vec2 x1=v1-e1*clamp(dot(v1,e1)/dot(e1,e1),0.,1.);
    vec2 x2=v2-e2*clamp(dot(v2,e2)/dot(e2,e2),0.,1.);
    float s=sign(e0.x*e2.y-e0.y*e2.x);
    vec2 d=min(min(vec2(dot(x0,x0),s*(v0.x*e0.y-v0.y*e0.x)),
                   vec2(dot(x1,x1),s*(v1.x*e1.y-v1.y*e1.x))),
                   vec2(dot(x2,x2),s*(v2.x*e2.y-v2.y*e2.x)));
    return -sqrt(d.x)*sign(d.y);
}
vec2 logo(vec3 p) {
    // Two contours are merged into ONE signed-distance solid. Previously
    // the arrow was raised 0.14 units above the ring and differed in depth,
    // leaving a visible ledge when the logo was rotated sideways.
    float ring=abs(length(p.xy+vec2(.035,.012))-.50)-.115;
    ring=max(ring,-sdBox(p.xy-vec2(.48,.38),vec2(.28,.31)));
    float direction=sdTriangle(p.xy,vec2(-.005,.128),
                                 vec2(.617,.128),vec2(.617,-.516));

    // Shared extrusion and bevel depth so the surface cannot show a
    // component-wise step at the joint (front OR rear).
    const float halfDepth=.118;
    const float bevel=.019;
    vec2 g=vec2(ring,abs(p.z)-halfDepth);
    float dg=length(max(g,0.0))+min(max(g.x,g.y),0.0)-bevel;
    vec2 a=vec2(direction,abs(p.z)-halfDepth);
    float da=length(max(a,0.0))+min(max(a.x,a.y),0.0)-bevel;

    // Polynomial smooth union fillets the contact of arrow and ring without
    // duplicating geometry or adding a second render pass.
    const float fillet=.072;
    float h=clamp(.5+.5*(dg-da)/fillet,0.0,1.0);
    float merged=mix(dg,da,h)-fillet*h*(1.0-h);

    // The two finishes are still distinguishable, but their transition
    // follows the continuous fillet instead of a harsh material-ID seam.
    float arrowTint=smoothstep(.06,.94,h);
    return vec2(merged,arrowTint);
}
vec3 invRotation(vec3 p,vec2 angle) {
    // Inverse object orientation for SDF evaluation.
    float c=cos(angle.x),s=sin(angle.x);
    p=vec3(c*p.x-s*p.z,p.y,s*p.x+c*p.z);
    c=cos(angle.y);s=sin(angle.y);
    return vec3(p.x,c*p.y+s*p.z,-s*p.y+c*p.z);
}
vec2 surface(vec3 p,vec2 angle) {
    return logo(invRotation(p,angle));
}
vec3 surfaceNormal(vec3 p,vec2 angle) {
    const float h=.0018;
    // Tetrahedral gradient: four samples instead of six. Smooth when rotated.
    vec3 a=vec3(1.,-1.,-1.),b=vec3(-1.,-1.,1.);
    vec3 c=vec3(-1.,1.,-1.),d=vec3(1.,1.,1.);
    return normalize(
        a*surface(p+h*a,angle).x+
        b*surface(p+h*b,angle).x+
        c*surface(p+h*c,angle).x+
        d*surface(p+h*d,angle).x);
}
vec3 background(vec2 screen,vec2 uv,bool dark) {
    vec3 upper=dark?vec3(.030,.066,.105):vec3(.948,.973,.995);
    vec3 lower=dark?vec3(.060,.143,.209):vec3(.843,.917,.965);
    vec3 color=mix(upper,lower,smoothstep(0.0,1.0,uv.y));
    float glow=exp(-dot(screen,screen)*.9);
    return color+(dark?vec3(.025,.084,.101):vec3(.030,.024,.013))*glow;
}
vec3 shade(vec3 p,vec3 ray,vec2 angle,float material,bool dark) {
    vec3 n=surfaceNormal(p,angle);
    vec3 eye=normalize(-ray);
    vec3 light=normalize(vec3(-.58,.72,.91));
    vec3 gold=normalize(vec3(.84,.28,.72));
    vec3 fill=normalize(vec3(-.46,-.65,.51));
    float d=max(dot(n,light),0.);
    float ambient=.31+max(dot(n,fill),0.)*.19;
    float rim=pow(1.-max(dot(n,eye),0.),2.5);
    float key=pow(max(dot(reflect(-light,n),eye),0.),45.);
    float warm=pow(max(dot(reflect(-gold,n),eye),0.),66.);
    float micro=pow(max(dot(reflect(-light,n),eye),0.),155.);
    vec3 body=dark?vec3(.73,.85,.92):vec3(.44,.63,.75);
    vec3 arrow=dark?vec3(.11,.65,.82):vec3(.07,.48,.66);
    vec3 tint=mix(body,arrow,material);
    vec3 col=tint*(ambient+.71*d);
    col+=key*vec3(.80,.97,1.)*.86;
    col+=micro*vec3(1.)*.42;
    col+=warm*vec3(1.,.72,.43)*.37;
    col+=rim*mix(vec3(.27,.52,.66),vec3(.09,.71,.82),material)*.64;
    return col;
}
void main() {
    vec2 uv=qt_TexCoord0;
    vec2 screen=vec2((uv.x-.5)*2.33, (.5-uv.y)*2.33*
                    params.paneSize.y/max(params.paneSize.x,1.0));
    screen.y+=.06;
    bool dark=params.darkMode>.5;
    vec3 backdrop=background(screen,uv,dark);

    const float toRad=.01745329251994;
    vec2 orient=vec2(
        -(params.orbitYaw+params.dragYaw)*toRad+
            (params.pointer.x-.5)*.085,
         -params.dragPitch*toRad+
            (params.pointer.y-.5)*.055);
    vec3 origin=vec3(0.,0.,2.75);
    vec3 ray=normalize(vec3(screen,-2.75));
    float t=0.;
    float nearest=100.;
    float nearestT=0.;
    float mat=0.;
    bool hit=false;
    // SDF sphere-tracing with an adaptive minimum step. Bound the number
    // of iterations across devices to keep render cost predictable.
    for(int i=0;i<69;i++) {
        vec3 pos=origin+ray*t;
        vec2 result=surface(pos,orient);
        if(result.x<nearest){nearest=result.x;nearestT=t;}
        if(result.x<.0013){hit=true;mat=result.y;break;}
        t+=max(result.x*.79,.0038);
        if(t>5.5)break;
    }

    vec3 color=backdrop;
    if(hit) {
        color=shade(origin+ray*t,ray,orient,mat,dark);
        color+=params.pulseValue*.06*vec3(.22,.82,.92);
        // Approximate analytical coverage from the implicit surface at
        // its closest ray intersection. Keeps edges soft on HiDPI and WASM.
        float pixel=2.33/max(params.paneSize.x,1.);
        float fade=smoothstep(pixel*.36,pixel*1.35,nearest);
        color=mix(color,backdrop,fade*.13);
    } else {
        // Missed rays just beside the silhouette get subpixel edge coverage
        // rather than hard stair-step pixels, without 4x full-frame tracing.
        float pixel=2.33/max(params.paneSize.x,1.);
        float fringe=1.-smoothstep(pixel*.20,pixel*1.50,nearest);
        if(fringe>0.001) {
            vec3 pos=origin+ray*nearestT;
            float m=surface(pos,orient).y;
            color=mix(backdrop,shade(pos,ray,orient,m,dark),fringe*.72);
        }
    }
    // Filmic rolloff suppresses oversaturated highlights and improves bevels.
    color=max(color,vec3(0.));
    color=color/(vec3(1.)+color*.23);
    color=pow(color,vec3(.96));
    fragColor=vec4(color,params.qt_Opacity);
}
