cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/platform/macOS/LocalSigningIdentity.cmake")

function(expect input identity status)
    genycaster_select_local_signing_identity("${input}" actual actual_status)
    if(NOT actual STREQUAL identity OR NOT actual_status STREQUAL status)
        message(FATAL_ERROR "Expected ${identity}/${status}; got ${actual}/${actual_status}")
    endif()
endfunction()

set(a "1111111111111111111111111111111111111111")
set(b "2222222222222222222222222222222222222222")
set(first "  1) ${a} \"Apple Development: Example (TEAM)\"")
set(second "  2) ${b} \"Apple Development: Example (TEAM)\"")
set(other "  2) ${b} \"Apple Development: Other (OTHER)\"")
expect("${first}\n  1 valid identities found" "${a}" selected)
expect("${first}\n${second}\n  2 valid identities found" "${a}" selected)
expect("${second}\n${first}\n  2 valid identities found" "${a}" selected)
expect("${first}\n${first}" "${a}" selected)
expect("${first}\n${other}" "" ambiguous)
expect("${other}\n${first}" "" ambiguous)
expect("  0 valid identities found" "" missing)
expect("  1) ${a} \"Developer ID Application: Example (TEAM)\"" "" missing)
expect("  1) ABC \"Apple Development: Example (TEAM)\"" "" missing)
expect("  1) aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \"Apple Development: Example (TEAM)\"" "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" selected)
message(STATUS "All 10 local signing identity cases passed")
