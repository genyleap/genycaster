# CPack project options are evaluated AFTER loading CPackConfig.cmake.
# Keeping NSIS snippets in this file avoids the additional CMake string
# escaping pass that corrupts Windows paths such as "$DESKTOP\GenyCaster".
# configure_file(@ONLY) replaces only the audited VC redistributable suffix.
if(NOT CPACK_GENERATOR STREQUAL "NSIS")
    return()
endif()

set(CPACK_NSIS_CREATE_ICONS_EXTRA [=[
CreateShortCut "$DESKTOP\GenyCaster.lnk" "$INSTDIR\Genycaster.exe"
]=])
set(CPACK_NSIS_DELETE_ICONS_EXTRA [=[
Delete "$DESKTOP\GenyCaster.lnk"
]=])

set(CPACK_NSIS_EXTRA_INSTALL_COMMANDS [=[
IfFileExists "$INSTDIR\vc_redist.@GENYCASTER_VC_REDIST_SUFFIX@.exe" +2 0
Abort "Microsoft Visual C++ runtime installer is missing"
DetailPrint "Installing Microsoft Visual C++ runtime"
ExecWait '"$INSTDIR\vc_redist.@GENYCASTER_VC_REDIST_SUFFIX@.exe" /install /quiet /norestart' $0
StrCmp $0 0 genycaster_vc_runtime_done
StrCmp $0 1638 genycaster_vc_runtime_done
; VC Redistributable may recommend a deferred restart; never force the
; application installer to display a reboot page or restart Windows.
StrCmp $0 3010 genycaster_vc_runtime_done
MessageBox MB_ICONSTOP|MB_OK "Microsoft Visual C++ runtime installation failed (code $0)."
Abort
genycaster_vc_runtime_done:
]=])
