// Windows executable metadata, configured by CMake from properties/Windows.
// The executable filename remains Genycaster.exe; the Qt target remains genycaster.
#include <winver.h>

#define IDI_ICON1 101
IDI_ICON1 ICON "@GENYCASTER_WINDOWS_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Genyleap Labs\0"
            VALUE "FileDescription", "GenyCaster\0"
            VALUE "Comments", "Native, local-first decentralized social client (GPLv3)\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Genyleap Labs.\0"
            VALUE "LegalTrademarks", "GenyCaster and Genyleap are trademarks of their respective owners.\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "Genycaster\0"
            VALUE "OriginalFilename", "Genycaster.exe\0"
            VALUE "ProductName", "GenyCaster\0"
            VALUE "ProductVersion", "@GENYCASTER_RELEASE_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
