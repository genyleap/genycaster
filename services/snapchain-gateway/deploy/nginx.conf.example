# Example origin vhost behind a proxied Cloudflare DNS record.
# Use Cloudflare SSL/TLS "Full (strict)" and install an Origin Certificate at the paths below.
server {
    listen 443 ssl http2;
    server_name snapchain.genyleap.com;

    ssl_certificate     /etc/ssl/cloudflare/snapchain.genyleap.com.pem;
    ssl_certificate_key /etc/ssl/cloudflare/snapchain.genyleap.com.key;

    client_max_body_size 128k;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
    }
}
