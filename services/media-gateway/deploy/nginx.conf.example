server {
    listen 443 ssl http2;
    server_name storage-farcaster.genyleap.com media-farcaster.genyleap.com;

    # Default multipart chunks are 8 MiB. Keep the proxy limit slightly above
    # the configured chunk size while still rejecting whole-file uploads.
    client_max_body_size 9m;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Do not spool media chunks to Nginx temporary files. The Node gateway
        # buffers at most one bounded part because SigV4 needs its payload hash.
        proxy_request_buffering off;
        proxy_buffering off;

        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_pass http://127.0.0.1:8790;
    }
}
