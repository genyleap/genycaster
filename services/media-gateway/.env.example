# Inside the container the Node server must listen on all interfaces. Docker still
# publishes the port only on the host loopback address through compose.yaml.
GENYLEAP_MEDIA_HOST=0.0.0.0
GENYLEAP_MEDIA_PORT=8790
GENYLEAP_MEDIA_PUBLIC_BASE_URL=https://media-farcaster.genyleap.com
GENYLEAP_MEDIA_SNAPCHAIN_BASE_URL=https://snapchain.genyleap.com
# Keep this secret durable: it authenticates upload tickets and long-lived managed-asset
# tokens. Rotating it invalidates existing cleanup tokens.
GENYLEAP_MEDIA_TICKET_SECRET=replace-with-at-least-32-random-characters

# Storage selection is a gateway concern. Genycaster Desktop never sees these values.
GENYLEAP_MEDIA_STORAGE_PROVIDER=quilibrium-qstorage
GENYLEAP_MEDIA_STORAGE_ENDPOINT=https://qstorage.quilibrium.com
GENYLEAP_MEDIA_STORAGE_REGION=q-world-1
GENYLEAP_MEDIA_STORAGE_BUCKET=genycaster
GENYLEAP_MEDIA_STORAGE_ACCESS_KEY_ID=
GENYLEAP_MEDIA_STORAGE_SECRET_ACCESS_KEY=
GENYLEAP_MEDIA_STORAGE_SESSION_TOKEN=

# QStorage reads use short-lived presigned GET URLs signed with SHA256("") rather
# than UNSIGNED-PAYLOAD; live QStorage returns AccessDenied for the latter. Upload
# writes use bounded multipart chunks relayed by the gateway and normal SigV4
# Authorization headers. Completion verification also uses the compatible GET path.
GENYLEAP_MEDIA_DOWNLOAD_URL_LIFETIME_SECONDS=900
GENYLEAP_MEDIA_STORAGE_VERIFICATION_URL_LIFETIME_SECONDS=60
GENYLEAP_MEDIA_MULTIPART_PART_BYTES=8388608

# Request-proof/ticket/rate-limit hardening.
GENYLEAP_MEDIA_PROOF_LIFETIME_SECONDS=300
GENYLEAP_MEDIA_TICKET_LIFETIME_SECONDS=1800
GENYLEAP_MEDIA_MAX_IMAGE_BYTES=26214400
GENYLEAP_MEDIA_MAX_VIDEO_BYTES=536870912
GENYLEAP_MEDIA_MAX_JSON_BYTES=65536
GENYLEAP_MEDIA_RATE_WINDOW_MS=60000
GENYLEAP_MEDIA_RATE_LIMIT=60
GENYLEAP_MEDIA_PART_RATE_LIMIT=240
GENYLEAP_MEDIA_TRUST_CLOUDFLARE=0

# Development only: override the default storage/native/genyleap_quilibrium_storage.node path.
# GENYLEAP_MEDIA_QUILIBRIUM_ADDON=/absolute/path/to/genyleap_quilibrium_storage.node
