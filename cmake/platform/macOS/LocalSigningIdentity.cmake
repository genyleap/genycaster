# Parse valid Apple Development identities reported by security find-identity -v.
# Multiple certificates with the same identity name are normal after renewal.
# Never choose between different developer names without explicit configuration.
function(genycaster_select_local_signing_identity identities out_identity out_status)
    string(REGEX MATCHALL "[0-9A-Fa-f]+ \"Apple Development:[^\n\r\"]+\""
        _matches "${identities}")
    set(_fingerprints "")
    set(_names "")
    foreach(_match IN LISTS _matches)
        string(REGEX MATCH "^[0-9A-Fa-f]+" _fingerprint "${_match}")
        string(LENGTH "${_fingerprint}" _length)
        if(NOT _length EQUAL 40)
            continue()
        endif()
        string(TOUPPER "${_fingerprint}" _fingerprint)
        string(REGEX REPLACE "^[0-9A-Fa-f]+ \"" "" _name "${_match}")
        string(REGEX REPLACE "\"$" "" _name "${_name}")
        list(APPEND _fingerprints "${_fingerprint}")
        list(APPEND _names "${_name}")
    endforeach()
    list(REMOVE_DUPLICATES _names)
    list(LENGTH _names _name_count)
    if(_name_count GREATER 1)
        set(${out_identity} "" PARENT_SCOPE)
        set(${out_status} "ambiguous" PARENT_SCOPE)
    elseif(_name_count EQUAL 1)
        list(REMOVE_DUPLICATES _fingerprints)
        list(SORT _fingerprints)
        list(GET _fingerprints 0 _selected)
        set(${out_identity} "${_selected}" PARENT_SCOPE)
        set(${out_status} "selected" PARENT_SCOPE)
    else()
        set(${out_identity} "" PARENT_SCOPE)
        set(${out_status} "missing" PARENT_SCOPE)
    endif()
endfunction()
