# Native Linux ARM64 release-build environment matching the hosted Ubuntu 24.04 job.
# Build this image on an aarch64 machine; Qt 6.12.0 remains in the host checkout
# and is mounted at the identical path during the build. No proprietary SDK is baked in.
FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive
# Fail fast on DNS failures rather than reporting dozens of missing packages.
RUN apt-get -o APT::Update::Error-Mode=any update && \
    apt-get install -y --no-install-recommends \
      ca-certificates software-properties-common gnupg git \
      python3 python3-venv python3-pip \
      ninja-build curl file patchelf libfuse2 zsync docker.io nodejs \
      libgl1 libegl1 libgl1-mesa-dev libopengl-dev libglx-dev libegl-dev libx11-dev \
      libxkbcommon-x11-0 libxcb-cursor0 \
      libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
      libxcb-render-util0 libxcb-xinerama0 \
      libxcb-shape0 libxcb-randr0 libxcb-shm0 libxcb-sync1 \
      libxcb-xfixes0 libxcb-xkb1 libxcb-glx0 libxcb-xinput0 \
      libxcb-render0 libxcb-util1 libx11-xcb1 libxcb-dri3-0 \
      libice6 libsm6 libxrandr2 \
      libboost-dev libsqlite3-dev libssl-dev libsecret-1-dev \
      libcurl4-openssl-dev libdbus-1-dev libfontconfig1 libfreetype6 \
      libgstreamer-plugins-bad1.0-0 libgstreamer-plugins-good1.0-0 \
      libpulse0 libasound2t64 \
      libminizip1t64 libsnappy1v5 libwebp7 libwebpdemux2 libwebpmux3 \
      libnss3 libnspr4 libxfixes3 libxdamage1 libxcomposite1 \
      liblcms2-2 libxtst6 libxkbfile1 \
      desktop-file-utils \
    && add-apt-repository -y ppa:ubuntu-toolchain-r/test \
    && apt-get -o APT::Update::Error-Mode=any update \
    && apt-get install -y --no-install-recommends gcc-16 g++-16 lld \
    && rm -rf /var/lib/apt/lists/*
# The actual local pipeline selects CC=gcc-16 and CXX=g++-16 explicitly.
# This CMake version matches the GitHub-hosted release workflow.
RUN python3 -m venv /opt/genycaster-release-tools && \
    /opt/genycaster-release-tools/bin/pip install --no-cache-dir 'cmake==4.4.4'
ENV PATH="/opt/genycaster-release-tools/bin:$PATH"
# linuxdeploy resolves Qt Multimedia's audio dependencies in the build
# container. Fail before the expensive full C++26 compile if PulseAudio/ALSA
# clients are absent from this minimal Ubuntu image.
RUN test -e /usr/lib/aarch64-linux-gnu/libpulse.so.0 && \
    test -e /usr/lib/aarch64-linux-gnu/libasound.so.2
# Check the exact GL/GLX CMake discovery needed by Qt6Gui *before* the
# expensive C++26 product build. Catch missing development symlinks early.
RUN mkdir -p /tmp/genycaster-gl-probe && \
    printf '%s\n' \
      'cmake_minimum_required(VERSION 3.25)' \
      'project(GenyCasterGraphicsPreflight LANGUAGES CXX)' \
      'find_package(OpenGL REQUIRED COMPONENTS OpenGL GLX)' \
      > /tmp/genycaster-gl-probe/CMakeLists.txt && \
    CC=gcc-16 CXX=g++-16 cmake -S /tmp/genycaster-gl-probe \
      -B /tmp/genycaster-gl-probe/build -G Ninja && \
    rm -rf /tmp/genycaster-gl-probe
